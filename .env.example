# ═══════════════════════════════════════════════
# Sovereign AI Pipeline - Environment Variables
# ═══════════════════════════════════════════════

# ── LLM Provider ────────────────────────────────
LLM_PROVIDER=gemini              # "gemini" or "openai"
LLM_MODEL=gemini-1.5-flash       # or gpt-4o-mini, llama3, etc.
GOOGLE_API_KEY=your_gemini_key

# ── OpenAI-Compatible (for LM Studio / Ollama) ─
OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=https://api.openai.com/v1  # or http://localhost:1234/v1

# ── Social Distribution ─────────────────────────
AYRSHARE_API_KEY=               # Optional: auto-post to TikTok/YT/IG

# ── B-Roll Fallback ─────────────────────────────
PEXELS_API_KEY=                 # Optional: free API for stock video fallback
