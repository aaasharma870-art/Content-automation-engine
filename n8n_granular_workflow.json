                        },
                        {
                            "name": "topic",
                            "value": "={{$node[\"Step 1: Research\"].json[\"best_topic\"]}}"
                        },
                        {
                            "name": "content_type",
                            "value": "quote"
                        },
                        {
                            "name": "script",
                            "value": "={{$node[\"Step 2: Write Script\"].json[\"script\"]}}"
                        }
                    ]
                }
            },
            "name": "Step 3: Build Spec",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 1,
            "position": [
                850,
                300
            ]
        },
        {
            "parameters": {
