                        },
                        {
                            "name": "content_type",
                            "value": "quote"
                        }
                    ]
                }
            },
            "name": "Step 2: Write Script",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 1,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
